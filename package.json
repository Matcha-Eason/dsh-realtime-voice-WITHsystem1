{
  "name": "dsh-realtime-voice",
  "version": "0.14.0",
  "description": "Main-model voice conversation for DeepSeek Harness with semantic turn decisions and bidirectional interruption.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "docs/**/*.md",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "scripts/setup-local-asr.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:client-bundle": "node scripts/check-client-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:client-bundle",
    "dev:link-dsh": "node scripts/link-dsh-app.mjs",
    "dev:dsh": "node scripts/dev-dsh.mjs",
    "prepack": "npm run build",
    "check:bailian": "node --env-file=.env.local scripts/check-bailian.mjs",
    "setup:asr": "node scripts/setup-local-asr.mjs",
    "bench:voice": "node --env-file=.env.local scripts/benchmark-voice.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Matcha-Eason/dsh-realtime-voice-WITHsystem1.git"
  },
  "homepage": "https://github.com/Matcha-Eason/dsh-realtime-voice-WITHsystem1#readme",
  "bugs": {
    "url": "https://github.com/Matcha-Eason/dsh-realtime-voice-WITHsystem1/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "realtime-voice",
    "asr",
    "tts",
    "qwen",
    "system1"
  ],
  "dependencies": {
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "2.0.1"
  }
}
