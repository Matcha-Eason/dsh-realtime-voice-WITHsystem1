# Host only. Copy to .env.local and set the Token Plan credential.
BAILIAN_TOKEN_PLAN_API_KEY=
# Optional: built DeepSeek Harness source checkout (defaults to ../deepseek-harness).
# DSH_SOURCE_ROOT=/absolute/path/to/deepseek-harness
# Optional: isolated development web server port and main model.
# DSH_VOICE_PORT=3081
# DSH_VOICE_MAIN_MODEL=deepseek-v4.1-flash

# Optional local SenseVoice directory containing model.int8.onnx and tokens.txt.
# npm run setup:asr downloads the default model; choose local ASR in plugin settings.
# DSH_VOICE_ASR_MODEL_DIR=/absolute/path/to/sensevoice-model
